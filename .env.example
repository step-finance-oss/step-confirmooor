# Local defaults. A .env.local file or process environment can override them.
THREAD_COUNT=3
NETWORK=devnet
MAX_TX_PER_SLOT=50
HTTP_BIND_ADDR=127.0.0.1:8080

# Match the producer's shard count. One local worker consumes all shards.
SHARD_TOTAL=12
CONF_SHARDS=1
MY_SHARD=0

# With three workers, set CONF_SHARDS=3 on each and MY_SHARD=0, 1 or 2.
# Numbered routes use shard modulo worker count. Historical routes use slot modulo
# worker count. Each worker receives the feed so it can track chain progress.

#------------ amqp

# Plaintext and the guest account are for a local development broker.
# For a remote broker use TLS, usually on port 5671, and supply its credentials.
AMQP_SECURE=false
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_VHOST=
AMQP_USER=guest
AMQP_PASS=guest

#------------ misc

#used for testing, will append this to the queue/exchange names as not to conflict
SUFFIX=your_name
RUST_LOG=warn
